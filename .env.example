# ── Required ──────────────────────────────────────────────
DATABASE_URI=mongodb://127.0.0.1:27017/xelarvis
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME=Xelarvis

# First admin user (used by seed scripts)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ── Media storage (Cloudinary) ────────────────────────────
# Required in production on Vercel (its filesystem is read-only/ephemeral). When all three are
# set, uploads are stored privately in Cloudinary and served through /api/media/file/* with the
# same access rules (candidate resumes stay private). Copy existing local files with:
#   npm run media:migrate -- --apply
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=xelarvis

# ── Email ─────────────────────────────────────────────────
# EMAIL_PROVIDER: smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_TO=
CONTACT_NOTIFY_EMAIL=
CAREERS_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Rate limiting (optional, recommended in production) ──
# Shared Upstash Redis store so limits hold across serverless instances. Without these an
# in-memory store is used per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional; loaded only after cookie consent) ─
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── AI assist in admin (optional) ─────────────────────────
AI_GATEWAY_API_KEY=
AI_MODEL=
OPENAI_API_KEY=

# ── Logging (optional) ───────────────────────────────────
LOG_LEVEL=info
