# ── Required ──────────────────────────────────────────────
DATABASE_URI=mongodb://127.0.0.1:27017/xelarvis
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME=Xelarvis

# First admin user (used by seed scripts)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ── Media storage (Cloudinary) ────────────────────────────
# Required in production on Vercel (its filesystem is read-only/ephemeral). When all three are
# set, uploads are stored privately in Cloudinary and served through /api/media/file/* with the
# same access rules (candidate resumes stay private). Copy existing local files with:
#   npm run media:migrate -- --apply
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=xelarvis

# ── Email ─────────────────────────────────────────────────
# EMAIL_PROVIDER: smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_TO=
CONTACT_NOTIFY_EMAIL=
CAREERS_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Rate limiting (optional, recommended in production) ──
# Shared Upstash Redis store so limits hold across serverless instances. Without these an
# in-memory store is used per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional; loaded only after cookie consent) ─
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── AI assist in admin (optional) ─────────────────────────
AI_GATEWAY_API_KEY=
AI_MODEL=
OPENAI_API_KEY=

# ── Logging (optional) ───────────────────────────────────
LOG_LEVEL=info

# ── Lead alerts (optional) ────────────────────────────────
# Slack incoming webhook (or any endpoint accepting { "text": "..." }) for new leads and the
# weekly digest.
LEAD_WEBHOOK_URL=

# ── Draft preview (optional) ──────────────────────────────
# Extra shared secret on /api/preview links; a signed-in CMS user is always required.
PREVIEW_SECRET=

# ── Error monitoring: Sentry (optional; browser SDK loads only after consent) ─
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Defaults to 1.0 in development and 0.1 elsewhere when unset
SENTRY_TRACES_SAMPLE_RATE=
# Defaults to VERCEL_GIT_COMMIT_SHA on Vercel
SENTRY_RELEASE=
# Source map upload at build time (all three required to enable)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=xelarvis
SENTRY_PROJECT=xelarvis-website
# CSP violation reports, e.g. Sentry's security endpoint
CSP_REPORT_URI=

# ── Booking: Cal.com (optional) ───────────────────────────
# Event link such as "xelarvis/discovery-call"; shows "Book a call" when set.
NEXT_PUBLIC_CALCOM_LINK=

# ── Spam protection: Cloudflare Turnstile (optional; both required to enable) ─
# Local dev can use Cloudflare's test keys (1x00000000000000000000AA / 1x0000000000000000000000000000000AA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames tokens may come from, comma-separated (e.g. "xelarvis.in,www.xelarvis.in").
# Defaults to the host of NEXT_PUBLIC_SITE_URL. Never include localhost in production.
TURNSTILE_HOSTNAMES=

# ── Scheduled jobs ────────────────────────────────────────
# Vercel Cron sends this as a bearer token to /api/payload-jobs/run (scheduled publish, weekly
# lead digest, analytics pruning, unconfirmed sign-up cleanup). Required in production.
CRON_SECRET=
