{
  "id": "/admin",
  "name": "Xelarvis CMS",
  "short_name": "XV CMS",
  "description": "Xelarvis enterprise content workspace.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F8FAFC",
  "theme_color": "#F8FAFC",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/admin-72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "/icons/admin-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/icons/admin-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icons/admin-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/icons/admin-152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/admin-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/admin-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/admin",
      "icons": [{ "src": "/icons/admin-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "description": "Open roles",
      "url": "/admin/collections/careers",
      "icons": [{ "src": "/icons/admin-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Candidates",
      "short_name": "Candidates",
      "description": "Job applications",
      "url": "/admin/collections/job-applications",
      "icons": [{ "src": "/icons/admin-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Media",
      "short_name": "Media",
      "url": "/admin/collections/media",
      "icons": [{ "src": "/icons/admin-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
